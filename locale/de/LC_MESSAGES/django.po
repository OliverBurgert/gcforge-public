#: .\templates\preferences\settings.html:333
msgid "Log templates"
msgstr "Log-Vorlagen"

#: .\templates\preferences\settings.html:335
msgid ""
"Reusable log text snippets with <code>[name]</code>-style placeholders.\n"
"            Available placeholders:\n"
"            <code>[name]</code>, <code>[gc_code]</code>, <code>[oc_code]</"
"code>,\n"
"            <code>[type]</code>, <code>[size]</code>, <code>[difficulty]</"
"code>, <code>[terrain]</code>,\n"
"            <code>[owner]</code>, <code>[hidden_date]</code>, "
"<code>[country]</code>, <code>[state]</code>,\n"
"            <code>[lat]</code>, <code>[lon]</code>, <code>[today]</code>, "
"<code>[log_date]</code>,\n"
"            <code>[log_type]</code>, <code>[username]</code>, "
"<code>[find_count]</code>.\n"
"            <br>\n"
"            Templates appear in the compose toolbar's <strong>📋</strong> "
"dropdown,\n"
"            filtered by the selected log type (templates with scope <em>any</"
"em> always show)."
msgstr ""
"Wiederverwendbare Log-Text-Schnipsel mit Platzhaltern im <code>[name]</code>-"
"Stil.\n"
"            Verfügbare Platzhalter:\n"
"            <code>[name]</code>, <code>[gc_code]</code>, <code>[oc_code]</"
"code>,\n"
"            <code>[type]</code>, <code>[size]</code>, <code>[difficulty]</"
"code>, <code>[terrain]</code>,\n"
"            <code>[owner]</code>, <code>[hidden_date]</code>, "
"<code>[country]</code>, <code>[state]</code>,\n"
"            <code>[lat]</code>, <code>[lon]</code>, <code>[today]</code>, "
"<code>[log_date]</code>,\n"
"            <code>[log_type]</code>, <code>[username]</code>, "
"<code>[find_count]</code>.\n"
"            <br>\n"
"            Vorlagen erscheinen im <strong>📋</strong>-Dropdown der Editor-"
"Toolbar,\n"
"            gefiltert nach dem ausgewählten Log-Typ (Vorlagen mit Bereich "
"<em>any</em> werden immer angezeigt)."

